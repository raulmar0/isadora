  "components": [
    {
      "name": "World control",
      "kind": "button",
      "refersTo": "world-button",
      "description": "A reset control beside the interactive miniature.",
      "html": "<button class=\"ds-world-button\" type=\"button\" aria-label=\"Restablecer vista\" title=\"Restablecer vista\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 10a8 8 0 1 1 1 7M4 4v6h6\"/></svg></button>",
      "css": ".ds-world-button{width:35px;height:35px;border:1px solid #d8ded2;border-radius:50%;background:var(--paper,#f6f3eb);color:var(--ink,#284967);display:grid;place-items:center;cursor:pointer;transition:background .2s,transform .2s}.ds-world-button:hover{background:#e4e9dc;transform:translateY(-2px)}.ds-world-button[aria-pressed=true]{background:var(--ink,#284967);color:var(--paper,#f6f3eb)}.ds-world-button:focus-visible,.ds-language button:focus-visible,.ds-card:focus-visible,.ds-brand:focus-visible{outline:3px solid var(--blue,#315f88);outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-world-button{transition:none}.ds-world-button:hover{transform:none}}"
    },
    {
      "name": "Pressed pause control",
      "kind": "button",
      "refersTo": "world-button-pressed",
      "description": "The pause toggle fills with ink when the animation is paused.",
      "html": "<button class=\"ds-world-button\" type=\"button\" aria-label=\"Reanudar animación\" title=\"Reanudar animación\" aria-pressed=\"true\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 5 10 7-10 7Z\"/></svg></button>",
      "css": ".ds-world-button{width:35px;height:35px;border:1px solid #d8ded2;border-radius:50%;background:var(--paper,#f6f3eb);color:var(--ink,#284967);display:grid;place-items:center;cursor:pointer;transition:background .2s,transform .2s}.ds-world-button:hover{background:#e4e9dc;transform:translateY(-2px)}.ds-world-button[aria-pressed=true]{background:var(--ink,#284967);color:var(--paper,#f6f3eb)}.ds-world-button:focus-visible,.ds-language button:focus-visible,.ds-card:focus-visible,.ds-brand:focus-visible{outline:3px solid var(--blue,#315f88);outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-world-button{transition:none}.ds-world-button:hover{transform:none}}"
